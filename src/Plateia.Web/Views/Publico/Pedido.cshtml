@model Pedido
@{
    Layout = "_LayoutPublico";
    var e = Model.Evento!;
    ViewData["Title"] = $"Pedido {Model.Codigo} · {e.Titulo}";
    ViewData["Cor"] = e.Cor;
    ViewData["LinkMarca"] = $"/e/{e.Slug}";
    var novo = Context.Request.Query["novo"] == "1";
    var itens = Model.Inscricoes.OrderBy(i => i.Status).ThenBy(i => i.Id).ToList();
    var ativos = itens.Where(i => i.Ativa).ToList();
    var aPagar = Model.APagar;
    var tinta = Texto.TintaSobre(e.Cor);
    var link = $"{Context.Request.Scheme}://{Context.Request.Host}/pedido/{Model.Codigo}";
}
<div class="pagina-pedido">
    <a class="voltar" href="/e/@e.Slug" style="margin:0">← @e.Titulo</a>
    @if (novo)
    {
        <div style="text-align:center;display:grid;gap:6px">
            <b class="display" style="font-size:40px">@(aPagar > 0 ? "Pedido reservado!" : "Pedido confirmado!")</b>
            <p class="suave">@(aPagar > 0 ? "Os lugares estão guardados. Conclua o pagamento para garantir os ingressos." : "Cada participante tem o próprio ingresso com QR code. Envie o link para cada um.")</p>
        </div>
    }

    <section class="pedido-cab cartaz" style="--cor:@e.Cor;--tinta:@tinta">
        <div class="linha"><span>Pedido <span class="mono">@Model.Codigo</span></span><span>@Hora.Data(e.InicioEm)</span></div>
        <h1 class="display">@e.Titulo</h1>
        <div class="linha"><span>@(e.Formato == FormatoEvento.Online ? "Online" : e.Local)</span><span>@ativos.Count ingresso(s)</span></div>
    </section>

    @if (TempData["erro"] is string erroPg) { <div class="alerta-caixa erro" role="alert">@erroPg</div> }

    @if (aPagar > 0)
    {
        var aberto = e.Status == StatusEvento.Publicado && (e.FimEm ?? e.InicioEm) > DateTime.UtcNow;
        var temPix = ViewBag.Pix == true && aberto;
        var temCartaoPagina = ViewBag.CartaoNaPagina == true && aberto;
        var temCartao = ViewBag.Cartao == true && aberto;
        var pixPronto = temPix && Model.PixCopiaCola is not null && Model.PixValor == aPagar;
        if (temPix || temCartao || temCartaoPagina)
        {
            <section class="pagamento" id="pagamento">
                <div class="pagamento-topo"><b>Falta pagar @Hora.Dinheiro(aPagar)</b><span>Os lugares estão reservados. Pague com cartão de crédito ou Pix.</span></div>
                <a class="btn pri grande" href="/pedido/@Model.Codigo/checkout">Ir para o pagamento</a>
            </section>
            @if (e.InstrucoesPagamento is { } outras) { <div class="pagar"><b>Outras formas de pagar</b><span>@outras</span></div> }
        }
        else
        {
            <div class="pagar">
                <b>Falta pagar @Hora.Dinheiro(aPagar)</b>
                <span>@(e.InstrucoesPagamento ?? "A organização vai entrar em contato com as instruções de pagamento.")</span>
                <span style="opacity:.75">Informe o código do pedido <b class="mono">@Model.Codigo</b> ao enviar o comprovante.</span>
            </div>
        }
    }

    <div style="display:grid;gap:10px">
        <h2 style="font-size:15px">Ingressos</h2>
        <ul class="lista-pedido">
            @{ var n = 0; }
            @foreach (var i in itens)
            {
                n++;
                <li class="@(i.Ativa ? "" : "cancelado")">
                    <a href="/ingresso/@i.Codigo">
                        <span class="num">@n</span>
                        <span><b>@i.Nome</b><small>@(i.TipoIngresso?.Espaco is { } esp ? $"{esp.Nome} · " : "")@i.TipoIngresso?.Nome@(i.Meia ? " (meia)" : "") · <span class="mono">@i.Codigo</span></small></span>
                        <span class="lado">
                            @if (!i.Ativa) { <span class="pilula perigo">Cancelado</span> }
                            else { <span class="pilula @Texto.ClassePagamento(i.Pagamento)">@Texto.NomePagamento(i.Pagamento)</span> }
                            <span>@Texto.Preco(i.Valor)</span>
                        </span>
                    </a>
                </li>
            }
        </ul>
        <p class="suave" style="font-size:13px">Toque num ingresso para ver o QR code. Mande o link de cada ingresso para o participante: ele é a entrada no evento.</p>
    </div>

    <div class="resumo-pedido">
        <div><span>Comprado por</span><span>@Model.Nome</span></div>
        <div><span>E-mail</span><span>@Model.Email</span></div>
        @if (Model.Desconto > 0) { <div><span>Desconto (cupom)</span><span>− @Hora.Dinheiro(Model.Desconto)</span></div> }
        <div class="total"><span>Total</span><span>@Texto.Preco(ativos.Sum(i => i.Valor))</span></div>
    </div>

    <div class="botoes-ingresso">
        <button class="btn" type="button" data-copiar="@link" data-aviso="Link do pedido copiado." style="grid-column:1/-1">Copiar link do pedido</button>
    </div>
</div>
