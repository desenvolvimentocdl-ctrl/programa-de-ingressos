@model PaginaEvento
@{
    Layout = "_LayoutPublico";
    var e = Model.Evento;
    ViewData["Title"] = e.Titulo;
    ViewData["Cor"] = e.Cor;
    ViewData["Descricao"] = e.Subtitulo ?? $"{Hora.DataLonga(e.InicioEm)} · {e.Local}";
    if (e.Imagem is { } img) ViewData["ImagemOg"] = $"{Context.Request.Scheme}://{Context.Request.Host}{img}";
    var local = Hora.Local(e.InicioEm);
    var form = ViewBag.Form as FormCheckout;
    var disponiveis = Model.Tipos.Where(t => t.AVenda).ToList();
    var poucas = Model.Livres <= Math.Max(5, e.Capacidade * 0.2);
    var temPago = disponiveis.Any(t => t.Preco > 0);
    string? cupomDigitado = form?.Cupom;
    var espacoLotado = Model.Espacos.Where(x => x.Livres <= 0).Select(x => x.Id).ToHashSet();
    var livresEspaco = Model.Espacos.ToDictionary(x => x.Id, x => x.Livres);
    // Quanto dá para comprar de cada tipo num pedido (limite do pedido, do tipo, do espaço e do evento).
    int MaxDoTipo(ResumoTipo t) => new[] { InscricaoService.MaxPorPedido, Model.Livres,
        t.Quantidade is { } q ? q - t.Vendidos : int.MaxValue,
        t.EspacoId is { } eid && livresEspaco.TryGetValue(eid, out var le) ? le : int.MaxValue }.Min();
    // Estado inicial do checkout: o que a pessoa já tinha preenchido, ou 1 ingresso do primeiro tipo disponível.
    var estado = form is not null
        ? new { participantes = form.Participantes.Select(x => new { tipo = x.TipoId, meia = x.Meia, nome = x.Nome, email = x.Email, telefone = x.Telefone, meu = x.Meu }).ToArray() }
        : new { participantes = disponiveis.Take(1).Select(t => new { tipo = t.Id, meia = false, nome = (string?)null, email = (string?)null, telefone = (string?)null, meu = true }).ToArray() };
    // Quem está logado já vem com os dados preenchidos.
    var nomeComprador = form?.Nome ?? (User.Identity?.IsAuthenticated == true ? User.Identity.Name : null);
    var emailComprador = form?.Email ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
    // Ingressos agrupados por espaço (sem espaços, um grupo só).
    var grupos = Model.Espacos.Count == 0
        ? new List<(ResumoEspaco? Espaco, List<ResumoTipo> Tipos)> { (null, Model.Tipos) }
        : Model.Espacos.Select(x => ((ResumoEspaco?)x, Model.Tipos.Where(t => t.EspacoId == x.Id).ToList())).Where(g => g.Item2.Count > 0).ToList();
    var produtor = e.Organizador;
}
@section Topo {
    @if (Model.Previa) { <div class="aviso-previa">Prévia: este evento está em rascunho e só você consegue ver esta página.</div> }
}

<section class="hero-evento @(e.Imagem is null ? "cartaz" : "com-imagem")" style="--cor:@e.Cor;--tinta:@Texto.TintaSobre(e.Cor)">
    @if (e.Imagem is { } capa) { <img class="hero-img" src="@capa" alt=""> }
    <div class="chips">
        <span>@Texto.NomeCategoria(e.Categoria)</span>
        <span>@Hora.Data(e.InicioEm)</span>
        <span>@(e.Formato == FormatoEvento.Online ? "Online" : e.CidadeUf.Length > 0 ? e.CidadeUf : e.Local)</span>
        @if (e.Status == StatusEvento.Cancelado) { <span>Cancelado</span> }
    </div>
    <h1 class="display">@e.Titulo</h1>
    @if (e.Subtitulo is { } s) { <p class="sub">@s</p> }
</section>

<div class="conteudo-evento">
    <div class="sobre">
        <div class="fatos">
            <div class="fato">
                <div class="dia"><small>@local.ToString("MMM", Hora.PtBr).TrimEnd('.')</small><b>@local.Day</b></div>
                <div><strong>@local.ToString("dddd", Hora.PtBr)</strong><p>@local.ToString("HH:mm")@(e.FimEm is { } f ? " às " + Hora.Local(f).ToString(Hora.Local(f).Date == local.Date ? "HH:mm" : "dd/MM HH:mm") : "")</p></div>
            </div>
            @if (e.Presencial)
            {
                <div class="fato">
                    <div class="dia icone" aria-hidden="true">⌖</div>
                    <div>
                        <strong>@e.Local</strong>
                        <p>@string.Join(" · ", new[] { e.Endereco, e.Bairro, e.CidadeUf }.Where(x => !string.IsNullOrWhiteSpace(x)))</p>
                        <a class="link-mapa" href="@Texto.LinkMapa(e)" target="_blank" rel="noopener">Como chegar ↗</a>
                    </div>
                </div>
            }
            @if (e.Formato != FormatoEvento.Presencial)
            {
                <div class="fato">
                    <div class="dia icone" aria-hidden="true">◉</div>
                    <div><strong>@(e.Formato == FormatoEvento.Online ? "Evento online" : "Também online")</strong><p>O link da transmissão aparece no seu ingresso.</p></div>
                </div>
            }
            <div class="fato">
                <div class="dia icone" aria-hidden="true">@(e.Classificacao == "Livre" || e.Classificacao is null ? "L" : e.Classificacao.TrimEnd('+'))</div>
                <div><strong>Classificação</strong><p>@(e.Classificacao is null or "Livre" ? "Livre para todos os públicos" : $"A partir de {e.Classificacao.TrimEnd('+')} anos")</p></div>
            </div>
        </div>

        @if (e.Descricao is { } d)
        {
            <div>
                <h2>Sobre o evento</h2>
                <p class="texto" style="margin-top:14px">@d</p>
            </div>
        }

        @if (Model.Espacos.Count > 0)
        {
            <div>
                <h2>Espaços</h2>
                <div class="espacos-pub">
                    @foreach (var x in Model.Espacos)
                    {
                        var ocup = x.Capacidade == 0 ? 1 : Math.Min(1, x.Ocupados / (double)x.Capacidade);
                        <div class="espaco-pub">
                            <div><b>@x.Nome</b>@if (x.Descricao is { } xd) { <p>@xd</p> }</div>
                            <span class="@(x.Livres <= 0 ? "esgotado-txt" : "")">@(x.Livres <= 0 ? "Esgotado" : ocup >= .8 ? $"Últimos {x.Livres} lugares" : $"{x.Capacidade} lugares")</span>
                            <div class="barra"><i style="--v:@Texto.N(ocup);--c:var(--cor)"></i></div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (produtor is not null)
        {
            <a class="organiza" href="@(produtor.Slug is { } ps && produtor.Aprovado ? $"/p/{ps}" : "#")">
                <span class="av" style="background:var(--sup-3);color:var(--texto)">@Texto.Iniciais(produtor.NomeExibicao)</span>
                <div><span>Produzido por</span><b>@produtor.NomeExibicao</b>@if (produtor.Bio is { } bio) { <small>@(bio.Length > 140 ? bio[..140] + "…" : bio)</small> }</div>
                <span class="seta">Ver perfil →</span>
            </a>
        }
    </div>

    <aside class="compra" id="inscricao">
        <div class="bilhete">
            <div class="topo-compra"><b>Ingressos</b><span class="mono" style="font-size:13px">Nº @Texto.Numero(e.Id)</span></div>
            <div class="picote" style="margin:0 18px"></div>
            @if (Model.AceitaInscricoes && disponiveis.Count > 0)
            {
                <form method="post" asp-antiforgery="true" action="/e/@e.Slug#inscricao" id="form-inscricao" class="checkout" data-cupom-url="/e/@e.Slug/cupom"
                      data-max="@InscricaoService.MaxPorPedido" data-livres="@Model.Livres" data-estado="@System.Text.Json.JsonSerializer.Serialize(estado)">
                    @if (ViewBag.Erro is string erro) { <div class="alerta-caixa erro" role="alert">@erro</div> }
                    @if (poucas) { <span class="restam">🔥 Restam @Model.Livres lugar(es)</span> }
                    <fieldset class="opcoes" style="border:0;padding:0;margin:0">
                        <legend class="passo"><span>1</span>Escolha os ingressos</legend>
                        @foreach (var (esp, tipos) in grupos)
                        {
                            @if (esp is not null) { <p class="grupo-espaco">@esp.Nome</p> }
                            @foreach (var t in tipos)
                            {
                                var lotado = t.EspacoId is { } eid && espacoLotado.Contains(eid);
                                var fora = !t.AVenda || lotado;
                                var maxTipo = fora ? 0 : Math.Max(0, MaxDoTipo(t));
                                // Ingresso com meia-entrada vira duas linhas: inteira e meia (50%).
                                var variantes = t.Meia && !fora ? new[] { false, true } : new[] { false };
                                @foreach (var meia in variantes)
                                {
                                    var preco = meia ? t.PrecoMeia : t.Preco;
                                    var rotulo = t.Meia && !fora ? $"{t.Nome} · {(meia ? "Meia-entrada" : "Inteira")}" : t.Nome;
                                    <div class="opcao qtd @(fora ? "esgotado" : "") @(meia ? "meia" : "")" data-tipo="@t.Id" data-meia="@(meia ? 1 : 0)" data-nome="@rotulo"
                                         data-max="@maxTipo" data-valor="@Texto.N((double)preco)">
                                        <span>
                                            <b>@rotulo</b>
                                            @if (lotado || t.Esgotado) { <small>Esgotado</small> }
                                            else if (t.Encerrado) { <small>Vendas encerradas</small> }
                                            else if (t.Situacao == SituacaoVenda.EmBreve) { <small class="em-breve">Vendas a partir de @Hora.Local(t.VendasDe!.Value).ToString("dd/MM 'às' HH'h'mm")</small> }
                                            else if (t.Situacao == SituacaoVenda.AguardaLote) { <small class="em-breve">Abre quando "@t.LoteAnterior" esgotar ou encerrar</small> }
                                            else
                                            {
                                                @if (meia) { <small>Estudantes, idosos, PcD e demais casos da lei. Apresente o documento na entrada.</small> }
                                                else if (t.Descricao is { } td) { <small>@td</small> }
                                                @if (!meia && t.VendasAte is { } ate) { <span class="lote">até @Hora.Local(ate).ToString("dd/MM 'às' HH'h'mm")</span> }
                                                @if (!meia && t.Restantes is > 0 and <= 20) { <span class="lote">últimos @t.Restantes</span> }
                                            }
                                            <span class="preco" data-preco="@Texto.N((double)preco)">@Texto.Preco(preco)</span>
                                        </span>
                                        @if (!fora)
                                        {
                                            <span class="contador">
                                                <button type="button" class="btn" data-menos aria-label="Menos um @rotulo">−</button>
                                                <output aria-live="polite" aria-label="Quantidade de @rotulo">0</output>
                                                <button type="button" class="btn" data-mais aria-label="Mais um @rotulo">+</button>
                                            </span>
                                        }
                                    </div>
                                }
                            }
                        }
                    </fieldset>

                    <fieldset class="bloco-checkout">
                        <legend class="passo"><span>2</span>Seus dados</legend>
                        <label class="campo">Nome completo<input name="nome" value="@nomeComprador" required maxlength="160" autocomplete="name"></label>
                        <label class="campo">E-mail <small>o pedido e os ingressos ficam ligados a ele</small><input type="email" name="email" value="@emailComprador" required maxlength="180" autocomplete="email"></label>
                        <label class="campo">WhatsApp <small>para avisos do evento</small><input name="telefone" value="@form?.Telefone" inputmode="tel" autocomplete="tel" placeholder="(34) 9 0000-0000"></label>
                    </fieldset>

                    <fieldset class="bloco-checkout" data-participantes-bloco hidden>
                        <legend class="passo"><span>3</span>Participantes</legend>
                        <p class="suave" style="font-size:13px;margin:0">Cada ingresso sai no nome de quem vai usar. E-mail e WhatsApp dos outros participantes são opcionais.</p>
                        <div class="participantes" data-participantes></div>
                    </fieldset>
                    <noscript><div class="alerta-caixa">Ative o JavaScript do navegador para escolher a quantidade de ingressos.</div></noscript>

                    @if (Model.TemCupons && temPago)
                    {
                        <div class="campo">Cupom de desconto <small>opcional</small>
                            <div class="cupom-linha">
                                <input name="cupom" value="@cupomDigitado" maxlength="30" autocomplete="off" spellcheck="false" aria-label="Cupom de desconto">
                                <button type="button" class="btn" data-aplicar-cupom>Aplicar</button>
                            </div>
                            <span class="cupom-msg" aria-live="polite"></span>
                        </div>
                    }
                    <input type="hidden" name="canal" value="@Model.Canal">
                    <div class="total-checkout" data-total hidden><span data-total-qtd></span><b data-total-valor></b></div>
                    <button class="btn pri grande" data-finalizar>Confirmar inscrição</button>
                    @if (temPago && Model.PagamentoOnline)
                    {
                        <p class="selo-cielo"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>Pagamento seguro pela Cielo: cartão ou Pix</p>
                    }
                    else
                    {
                        <p class="suave" style="font-size:12px;text-align:center">Você recebe o ingresso com QR code na hora. Se houver valor, as instruções de pagamento aparecem nele.</p>
                    }
                </form>
            }
            else
            {
                <div class="fechado">
                    <b>@(e.Status switch { StatusEvento.Encerrado => "Evento encerrado", StatusEvento.Cancelado => "Evento cancelado", _ => Model.Livres <= 0 || Model.Tipos.All(t => t.Esgotado) ? "Esgotado" : Model.Tipos.Any(t => t.Situacao == SituacaoVenda.EmBreve) && e.InscricoesAbertas ? "Vendas em breve" : "Inscrições fechadas" })</b>
                    <p class="suave">@(e.Status == StatusEvento.Encerrado ? "Obrigado a quem participou!" : "Fale com o produtor para saber se abrirão novas vagas.")</p>
                </div>
            }
        </div>
        <button class="btn compartilhar-evento" type="button" data-compartilhar="@($"{Context.Request.Scheme}://{Context.Request.Host}/e/{e.Slug}")" data-titulo="@e.Titulo">Compartilhar evento</button>
    </aside>
</div>

@if (Model.Relacionados.Count > 0)
{
    <section class="vitrine" style="padding-top:0">
        <div class="faixa-topo"><h2 class="display">Você também pode gostar</h2></div>
        <div class="grade-pub">@foreach (var c in Model.Relacionados) { <partial name="_CartaoPublico" model="c" /> }</div>
    </section>
}
