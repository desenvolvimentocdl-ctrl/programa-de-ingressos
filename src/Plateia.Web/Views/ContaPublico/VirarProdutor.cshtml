@{
    Layout = "_LayoutPublico";
    ViewData["Title"] = "Venda ingressos no Plateia";
}
<div class="pagina-conta">
    <div class="secao-conta" style="max-width:520px;margin:0 auto">
        <h1 class="display" style="font-size:44px">Quero vender ingressos</h1>
        <p class="suave">Ative a área de produtor na sua conta para criar eventos, vender com Pix e cartão, divulgar e fazer o check-in. Seus ingressos continuam em "Meus ingressos".</p>
        @if (ViewBag.Erro is string erro) { <div class="alerta-caixa erro" role="alert">@erro</div> }
        <form method="post" asp-antiforgery="true" action="/virar-produtor" style="display:grid;gap:14px">
            <label class="campo">Nome do produtor <small>como aparece para o público (empresa, coletivo, marca). Opcional.</small><input name="marca" maxlength="120" placeholder="Ex.: Estúdio Movimento"></label>
            <div class="grade-form">
                <label class="campo s3">WhatsApp<input name="telefone" inputmode="tel" autocomplete="tel"></label>
                <label class="campo s3">Cidade<input name="cidade" maxlength="80"></label>
            </div>
            <label class="check"><input type="checkbox" name="aceite" value="true" required> Li e aceito os termos de uso para produtores.</label>
            <button class="btn pri grande">Ativar área de produtor</button>
            <p class="suave" style="font-size:13px;text-align:center">Seu cadastro passa por uma aprovação rápida antes da primeira publicação. Enquanto isso, você já pode montar os eventos.</p>
        </form>
    </div>
</div>
