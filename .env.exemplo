# Copie para .env (que NÃO vai para o Git) e preencha.
ConnectionStrings__Plateia=Server=SERVIDOR_MYSQL;Database=Plateia;User=plateia;Password=SENHA_DO_USUARIO_PLATEIA
Admin__Nome=Administrador
Admin__Email=
Admin__Senha=
# Só para demonstração: cria eventos e participantes fictícios se o banco estiver vazio.
Demo__Criar=false

# Pagamento online — Link de Pagamento da Cielo (conta nova).
# Backoffice Cielo → Configurações → Dados cadastrais → Credenciais de API (Link de Pagamento).
# Sem ClientId/ClientSecret, o sistema funciona com pagamento manual (instruções no ingresso).
Cielo__ClientId=
Cielo__ClientSecret=
# Texto na fatura do cartão (até 13 caracteres, sem acento).
Cielo__SoftDescriptor=
Cielo__MaxParcelas=1
# Uma senha longa qualquer; vai no fim das URLs de notificação cadastradas na Cielo (?chave=...).
Cielo__ChaveNotificacao=
# Página de checkout do Plateia: cartão de crédito digitado no site (Silent Order Post: o cartão vai do navegador
# direto para a Cielo, o servidor só recebe um token) e Pix com QR Code. API E-commerce Cielo 3.0.
# Peça à Cielo para habilitar o Silent Order Post e o Pix na conta. Cielo__MaxParcelas define o parcelamento.
# Peça à Cielo para cadastrar a notificação: https://SEU-DOMINIO/cielo/pix/notificacao?chave=CHAVE
Cielo__MerchantId=
Cielo__MerchantKey=
# true = ambiente de testes (sandbox) da Cielo.
Cielo__Sandbox=false

# E-mail (códigos de "esqueci minha senha" e de confirmação). Ex.: Gmail com "senha de app": smtp.gmail.com / 587.
Email__Host=
Email__Porta=587
Email__Usuario=
Email__Senha=
Email__Remetente=
# Sem SMTP: os e-mails viram arquivos .txt nesta pasta (só para testes).
Email__PastaTeste=

# Endereço oficial do site (com https). Quem abrir por outro endereço (IP, http) é redirecionado para ele.
Site__UrlPublica=

# Entrar / criar conta com Google, Apple (iCloud) e Microsoft (Outlook/Hotmail).
# Cada um só aparece quando as credenciais estão preenchidas. Exigem o site num domínio com https.
# Endereços de retorno a cadastrar em cada provedor: https://SEU-DOMINIO/entrar/{google|apple|microsoft}/retorno
# Google: console.cloud.google.com → APIs e serviços → Credenciais → ID do cliente OAuth (Aplicativo da Web).
Login__Google__ClientId=
Login__Google__ClientSecret=
# Microsoft: portal.azure.com → Registros de aplicativo (contas pessoais e corporativas) → Certificados e segredos.
Login__Microsoft__ClientId=
Login__Microsoft__ClientSecret=
# Apple (requer Apple Developer Program): Services ID, Team ID, Key ID e o caminho do arquivo .p8 da chave "Sign in with Apple".
Login__Apple__ClientId=
Login__Apple__TeamId=
Login__Apple__KeyId=
Login__Apple__ArquivoChave=
# Atrás de proxy/HTTPS (nginx, IIS, Cloudflare): faz o site enxergar o https original (necessário para os logins acima).
ASPNETCORE_FORWARDEDHEADERS_ENABLED=false
